{
  "name": "erp-inventario-backend",
  "version": "1.0.0",
  "description": "API REST del ERP de inventario (Express + PostgreSQL + JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node db/setup.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/setup.js && node db/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
